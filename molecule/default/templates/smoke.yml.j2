---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ mol__smoke_namespace }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ mol__smoke_app_name }}
  namespace: {{ mol__smoke_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ mol__smoke_app_name }}
  template:
    metadata:
      labels:
        app: {{ mol__smoke_app_name }}
    spec:
      nodeSelector:
        kubernetes.io/hostname: {{ mol__dedicated_workers | first }}
      containers:
        - name: nginx
          image: nginx:1.27-alpine
          ports:
            - containerPort: 80
          readinessProbe:
            httpGet:
              path: /
              port: 80
---
apiVersion: v1
kind: Service
metadata:
  name: {{ mol__smoke_app_name }}
  namespace: {{ mol__smoke_namespace }}
spec:
  type: NodePort
  selector:
    app: {{ mol__smoke_app_name }}
  ports:
    - port: 80
      targetPort: 80
      nodePort: {{ mol__smoke_node_port }}
      protocol: TCP
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: smoke-client
  namespace: {{ mol__smoke_namespace }}
spec:
  selector:
    matchLabels:
      app: smoke-client
  template:
    metadata:
      labels:
        app: smoke-client
    spec:
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: kubernetes.io/hostname
                    operator: In
                    values: {{ mol__dedicated_workers | to_json }}
      containers:
        - name: client
          image: busybox:1.37.0
          command: ["sleep", "2147483647"]
